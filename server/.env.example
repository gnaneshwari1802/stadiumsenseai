# Runtime
NODE_ENV=production
PORT=5000

# Comma-separated browser origins allowed to call this API.
CLIENT_URL=https://dashboard.example.com

# Infrastructure and provider credentials (use your deployment secret manager).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/StadiumSenseAI?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEATHER_API_KEY=replace-with-your-openweathermap-api-key
WEATHER_CITY=Hyderabad
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Secret used by trusted CCTV/IoT/edge services to submit live readings.
# Generate a long random value and keep it server-side only.
TELEMETRY_INGEST_KEY=replace-with-a-long-random-ingestion-secret

# Leave false in production. Set true for a self-contained hackathon demo with simulated operations data.
ENABLE_DEMO_TELEMETRY=true
